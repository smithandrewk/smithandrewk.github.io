---
import ReverbPedal from './ReverbPedal.astro';
// Progressive enhancement: the existing portrait remains useful without WebGL.
const naturals = ['C', 'D', 'E', 'F', 'G', 'A', 'B', 'C'];
const semitones = [0, 2, 4, 5, 7, 9, 11, 12];
const letters = ['A', 'S', 'D', 'F', 'G', 'H', 'J', 'K'];
const sharps = [{ note: 'C sharp', midi: 61, position: 1, letter: 'W' }, { note: 'D sharp', midi: 63, position: 2, letter: 'E' }, { note: 'F sharp', midi: 66, position: 4, letter: 'T' }, { note: 'G sharp', midi: 68, position: 5, letter: 'Y' }, { note: 'A sharp', midi: 70, position: 6, letter: 'U' }];
---

<section class="portrait-track" data-voxel-track aria-labelledby="hero-title">
  <div class="portrait-sticky" data-voxel-sticky>
    <div class="portrait-copy"><slot /></div>
    <div class="portrait-art">
      <div
        class="portrait-stage"
        data-voxel-stage
        role="img"
        aria-label="A block sculpture of Andrew in a red cap, white tee and pale jeans, assembling as you scroll."
      >
        <img
          data-voxel-fallback
          src="/media/about/profile.jpg"
          alt="Andrew Smith"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="600"
          height="800"
          class="portrait-fallback"
        />
        <div data-instrument-hitarea="keys" class="instrument-hitarea" aria-hidden="true" hidden></div>
        <div data-instrument-hitarea="knob" class="instrument-hitarea" aria-hidden="true" hidden></div>
        {['mix','space','bypass'].map(name => <div data-instrument-hitarea={name} class="instrument-hitarea" aria-hidden="true" hidden></div>)}
      </div>

      <p class="performance-caption" data-performance-caption hidden>
        <span><b>20%</b> playing keys.</span>
        <small>Moog Subsequent 37</small>
      </p>

      <ReverbPedal />

      <div class="instrument-invite" data-instrument-invite hidden>
        <button type="button" data-instrument-open aria-expanded="false" aria-controls="instrument-controls">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M8 5v14M13 5v14M18 5v14M6 5v7M11 5v7M16 5v7"/></svg>
          Your turn. Play the Moog.
        </button>
      </div>
      <div class="instrument-controls" id="instrument-controls" data-instrument-controls hidden role="group" aria-label="Play the synthesizer">
        <div class="instrument-tools">
          <div class="instrument-readout"><span class="sound-light" aria-hidden="true"></span><span data-instrument-note>YOUR TURN</span></div>
          <label class="instrument-filter">Tone <input data-instrument-filter aria-label="Synthesizer filter cutoff" type="range" min="0" max="100" value="52" /><output data-instrument-frequency>990 Hz</output></label>
          <button type="button" class="instrument-done" data-instrument-close aria-label="Stop playing and return to portrait">Done <span aria-hidden="true">↗</span></button>
        </div>
        <div class="instrument-keyboard" data-instrument-keyboard role="group" aria-label="One octave of playable keys">
          {naturals.map((note, i) => <button type="button" class="instrument-key" data-midi={60 + semitones[i]} aria-label={`Play ${note}${i === 7 ? 5 : 4}`}><span>{note}</span><kbd aria-hidden="true">{letters[i]}</kbd></button>)}
          {sharps.map(key => <button type="button" class="instrument-key instrument-key-black" data-midi={key.midi} aria-label={`Play ${key.note} 4`} style={`--key-position: ${key.position}`}><kbd aria-hidden="true">{key.letter}</kbd></button>)}
        </div>
        <p class="instrument-tip" data-instrument-tip>Hold a key · slide for notes · ↑ brighter ↓ warmer</p>
        <span class="portrait-help" data-instrument-status role="status"></span>
      </div>

      <div class="portrait-hints" data-voxel-hints hidden>
        <span class="portrait-hint portrait-scroll" data-voxel-scroll-hint>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 4v16M8 8l4-4 4 4M8 16l4 4 4-4" />
          </svg>
          <span data-voxel-scroll-label>Scroll to assemble</span>
        </span>
        <span class="portrait-hint portrait-drag">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 12h16M8 8l-4 4 4 4M16 8l4 4-4 4" />
          </svg>
          <span>Drag to rotate</span>
        </span>
      </div>
      <span id="portrait-help" class="portrait-help" data-voxel-help>
        Drag sideways or use the arrow keys to rotate. Scroll or use Page Up and Page Down to assemble the portrait, then take a seat at a Moog Subsequent 37. Escape resets the view.
      </span>
    </div>
  </div>
</section>

<script>
  import { observePortrait } from '../scripts/portrait-loader';
  observePortrait();
</script>

<style>
  .portrait-track { position: relative; min-width: 0; overflow-anchor: none; }
  :global(html.js) .portrait-track { min-height: calc(var(--portrait-viewport-height, 100svh) * 4.4 - 4rem); }
  .portrait-sticky {
    position: sticky;
    top: 4rem;
    height: calc(var(--portrait-viewport-height, 100svh) - 4rem);
    min-height: 48rem;
    max-width: 72rem;
    margin-inline: auto;
    padding: .5rem 1.5rem 1.5rem;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 1.5rem;
  }
  .portrait-copy { min-width: 0; order: 2; }
  .portrait-art { position: relative; min-width: 0; min-height: 0; order: 1; }
  .portrait-stage { position: absolute; inset: 0 0 3rem; touch-action: pan-y pinch-zoom; overflow: hidden; }
  .portrait-stage :global(canvas) { display: block; width: 100%; height: 100%; }
  .instrument-hitarea { position: absolute; inset: 0; touch-action: none; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
  .instrument-hitarea[hidden] { display: none; }
  .portrait-track[data-ready] .portrait-stage { cursor: grab; }
  .portrait-stage[data-dragging] { cursor: grabbing; }
  .portrait-track[data-instrument-open] .portrait-stage { bottom: 8rem; cursor: pointer; }
  .portrait-stage:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -2px; border-radius: var(--radius-control); }
  .portrait-fallback { width: 100%; height: 100%; object-fit: contain; object-position: center; }
  .performance-caption { position: absolute; top: .5rem; inset-inline: 0; text-align: center; pointer-events: none; color: var(--color-ink); line-height: 1.3; }
  .performance-caption[hidden] { display: none; }
  .performance-caption span { font-size: 1rem; letter-spacing: -.02em; }
  .performance-caption b { font-family: var(--font-mono); font-weight: 400; color: var(--color-accent); margin-right: .25rem; }
  .performance-caption small { display: block; margin-top: .35rem; font-family: var(--font-mono); color: var(--color-muted); font-size: .6rem; letter-spacing: .13em; text-transform: uppercase; }
  .instrument-invite { position: absolute; inset: auto 0 0; display: flex; justify-content: center; }
  .instrument-invite button { display: inline-flex; gap: .6rem; align-items: center; min-height: 44px; padding: .5rem 1.2rem; border: 1px solid var(--color-accent); border-radius: 999px; font-size: .8rem; color: white; background: var(--color-accent); cursor: pointer; box-shadow: 0 4px 18px color-mix(in srgb, var(--color-accent) 20%, transparent); transition: filter .2s, transform .2s; }
  .instrument-invite button:hover { filter: brightness(1.1); transform: translateY(-1px); }
  .instrument-invite svg { width: 18px; height: 18px; }
  .instrument-controls { position: absolute; inset: auto 0 0; padding-inline: .5rem; }
  .instrument-invite[hidden], .instrument-controls[hidden] { display: none; }
  .instrument-tools { display: flex; align-items: center; justify-content: space-between; gap: .5rem; height: 44px; font-size: .65rem; }
  .instrument-readout { display: flex; align-items: center; gap: .4rem; min-width: 4.8rem; color: var(--color-accent); font-family: var(--font-mono); letter-spacing: .04em; }
  .sound-light { width: 5px; height: 5px; border-radius: 50%; background: currentColor; opacity: .35; }
  .portrait-track[data-note] .sound-light { opacity: 1; box-shadow: 0 0 8px color-mix(in srgb, var(--color-accent) 50%, transparent); }
  .instrument-filter { display: flex; align-items: center; gap: .4rem; color: var(--color-muted); }
  .instrument-filter input { width: clamp(45px, 6vw, 85px); height: 44px; accent-color: var(--color-accent); cursor: ew-resize; }
  .instrument-filter output { width: 3.3rem; font-size: .6rem; font-family: var(--font-mono); }
  .instrument-done { min-width: 44px; min-height: 44px; cursor: pointer; color: var(--color-ink); }
  .instrument-done span { margin-left: .25rem; color: var(--color-muted); }
  .instrument-keyboard { display: flex; height: 56px; position: relative; gap: 3px; touch-action: none; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
  .instrument-key { position: relative; flex: 1; display: flex; justify-content: space-between; align-items: end; padding: 0 .35rem .35rem; border: 1px solid #d1ccc1; border-bottom: 3px solid #c4bdae; border-radius: 3px 3px 5px 5px; background: #f5f2e9; color: #645d51; font-family: var(--font-mono); font-size: .6rem; cursor: pointer; touch-action: manipulation; }
  .instrument-key kbd { font-size: .5rem; opacity: .55; }
  .instrument-key-black { position: absolute; z-index: 1; top: 0; left: calc(var(--key-position) * 12.5% - 3.75%); width: 7.5%; min-width: 24px; height: 33px; justify-content: center; border-color: #1f2525; border-bottom-color: #080f10; background: #303838; color: #eee9dc; }
  .instrument-key[data-pressed], .instrument-key:active { background: #b6b6e2; border-color: #9294c2; transform: translateY(2px); }
  .instrument-key-black[data-pressed], .instrument-key-black:active { background: #6364a4; }
  .instrument-tip { text-align: center; margin-top: .5rem; font-size: .6rem; color: var(--color-muted); }
  .instrument-controls button:focus-visible, .instrument-invite button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  @media (max-width: 380px) { .instrument-filter output { display: none; } }
  @media (hover: none) { .instrument-key kbd { display: none; } }
  .portrait-hints {
    position: absolute; inset: auto 0 0;
    display: flex; justify-content: center; align-items: center; flex-wrap: wrap;
    gap: .5rem 1.5rem; min-height: 2rem;
    color: var(--color-muted); font-size: .75rem;
  }
  .portrait-hints[hidden], .portrait-hint[hidden], .portrait-fallback[hidden] { display: none; }
  .portrait-hint { display: inline-flex; align-items: center; gap: .375rem; white-space: nowrap; }
  .portrait-hint svg { width: 1.125rem; height: 1.125rem; color: var(--color-accent); animation: portrait-cue 3s ease-in-out infinite; }
  .portrait-drag svg { animation-delay: 1.5s; }
  .portrait-track[data-scroll-used] .portrait-scroll svg,
  .portrait-track[data-drag-used] .portrait-drag svg { animation: none; opacity: .7; }
  .portrait-track[data-visible="false"] .portrait-hint svg { animation-play-state: paused; }
  .portrait-help { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @keyframes portrait-cue {
    0%, 100% { opacity: .4; }
    50% { opacity: 1; }
  }
  .portrait-track[data-unavailable] { min-height: 0 !important; }
  @media (min-width: 768px) {
    .portrait-sticky {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: minmax(0, 1fr);
      gap: 2rem;
      padding: 2rem 1.5rem 1.5rem;
      min-height: 32rem;
    }
    .portrait-copy { order: 1; align-self: center; padding-bottom: 4rem; }
    .portrait-art { order: 2; }
  }
  @media (min-width: 1024px) {
    .portrait-sticky { padding-inline: 2rem; gap: 3rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .portrait-hint svg { animation: none; }
    :global(html.js) .portrait-track { min-height: 0; }
    .portrait-sticky { position: relative; top: 0; }
  }
</style>
