---
// Progressive enhancement: the existing portrait remains useful without WebGL.
---

<div class="portrait-track" data-voxel-track>
  <div class="portrait-sticky" data-voxel-sticky>
    <div
      class="portrait-stage"
      data-voxel-stage
      role="img"
      aria-label="A block sculpture of Andrew in a red cap, white tee and pale jeans, assembling as you scroll."
    >
      <img
        data-voxel-fallback
        src="/media/about/profile.jpg"
        alt="Andrew Smith"
        loading="lazy"
        decoding="async"
        width="600"
        height="800"
        class="portrait-fallback"
      />
    </div>

    <div class="portrait-toolbar" data-voxel-controls hidden>
      <p class="portrait-status" data-voxel-status>Scroll to assemble</p>
      <div class="portrait-actions">
        <button type="button" class="portrait-button" data-voxel-finish>Assemble</button>
        <button
          type="button"
          class="portrait-button"
          data-voxel-rotate
          aria-pressed="false"
          aria-controls="portrait-angle-controls"
        >Rotate</button>
      </div>
      <div id="portrait-angle-controls" class="portrait-angle" data-voxel-angle-controls hidden>
        <label for="portrait-angle">Turn the portrait</label>
        <input id="portrait-angle" data-voxel-angle type="range" min="-180" max="180" value="-24" />
        <span>Drag sideways, or use the slider. Escape to close.</span>
      </div>
    </div>
    <span class="portrait-announcement" data-voxel-announcement aria-live="polite"></span>
  </div>
</div>

<script>
  import { observePortrait } from '../scripts/portrait-loader';
  observePortrait();
</script>

<style>
  .portrait-track { position: relative; min-width: 0; }
  :global(html.js) .portrait-track { min-height: calc(100svh + 28rem); }
  .portrait-sticky {
    position: sticky;
    top: 6rem;
    height: min(43rem, calc(100svh - 8rem));
    min-height: 25rem;
  }
  .portrait-stage { position: absolute; inset: 0 0 4.5rem; touch-action: pan-y; overflow: hidden; }
  .portrait-stage :global(canvas) { display: block; width: 100%; height: 100%; }
  .portrait-stage[data-rotating] { cursor: grab; }
  .portrait-stage[data-rotating]:active { cursor: grabbing; }
  .portrait-fallback { width: 100%; height: 100%; object-fit: contain; object-position: center; }
  .portrait-toolbar {
    position: absolute; inset: auto 0 0;
    display: flex; justify-content: space-between; align-items: center; gap: .75rem;
    min-height: 3rem; border-top: 1px solid var(--color-line); padding-top: .75rem;
  }
  .portrait-toolbar[hidden], .portrait-angle[hidden], .portrait-fallback[hidden] { display: none; }
  .portrait-status { margin: 0; font-size: .8125rem; color: var(--color-muted); }
  .portrait-actions { display: flex; gap: .375rem; }
  .portrait-button {
    font: inherit; font-size: .8125rem; min-height: 2.75rem; padding: .5rem .75rem;
    color: var(--color-ink); background: var(--color-paper);
    border: 1px solid var(--color-line-strong); border-radius: var(--radius-control); cursor: pointer;
  }
  .portrait-button:hover { background: var(--color-surface); border-color: var(--color-ink); }
  .portrait-button[aria-pressed="true"] { background: var(--color-ink); color: var(--color-paper); }
  .portrait-angle {
    position: absolute; right: 0; bottom: 4rem; width: min(16rem, 100%);
    background: var(--color-paper); border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-control); padding: 1rem; box-shadow: var(--shadow-md);
    color: var(--color-ink); font-size: .875rem;
  }
  .portrait-angle input { display: block; width: 100%; height: 2.75rem; accent-color: var(--color-accent); }
  .portrait-angle span { font-size: .75rem; color: var(--color-muted); line-height: 1.5; display: block; }
  .portrait-announcement { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .portrait-track[data-unavailable] { min-height: 0 !important; }
  @media (max-width: 1023px) {
    :global(html.js) .portrait-track { min-height: calc(100svh + 20rem); }
    .portrait-sticky { top: 5rem; height: min(38rem, calc(100svh - 7rem)); }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .portrait-track { min-height: 0; }
    .portrait-sticky { position: relative; top: 0; }
  }
</style>
