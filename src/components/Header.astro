---
import { Icon } from 'astro-icon/components';

const pathname = Astro.url.pathname;

// Labels and hrefs are unchanged from the previous site: muscle memory and
// inbound links both depend on them.
const navLinks = [
  { href: '/feed', label: 'Feed' },
  { href: '/orbit', label: 'Orbit' },
  { href: '/blog', label: 'Journal' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/timeline', label: 'Timeline' },
  { href: '/consuming', label: 'Consuming' },
];

function isActive(href: string): boolean {
  return pathname.startsWith(href);
}
---

<!-- 64px tall, single line at desktop. -->
<header class="fixed top-0 left-0 right-0 z-50 border-b border-line bg-paper/85 backdrop-blur-md theme-fade">
  <nav class="max-w-6xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <a
        href="/"
        class="font-mono text-[0.9375rem] font-medium tracking-tight text-ink hover:text-accent transition-colors"
      >
        A. Smith
      </a>

      <div class="flex items-center gap-1">
        <div class="hidden md:flex items-center gap-1">
        {navLinks.map(link => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              "relative px-3 py-2 text-sm transition-colors",
              isActive(link.href) ? "text-ink" : "text-muted hover:text-ink"
            ]}
          >
            {link.label}
            {isActive(link.href) && (
              <span class="absolute inset-x-3 -bottom-px h-px bg-accent"></span>
            )}
          </a>
        ))}
        </div>

        <button
          id="theme-toggle"
          class="ml-1 grid place-items-center w-9 h-9 rounded-[4px] text-muted hover:text-ink hover:bg-surface transition-colors"
          aria-label="Toggle dark theme"
          aria-pressed="false"
        >
          <Icon name="ph:circle-half-tilt" class="w-[18px] h-[18px]" />
        </button>

      <button
        id="mobile-menu-button"
        class="md:hidden grid place-items-center w-9 h-9 -mr-2 text-muted hover:text-ink transition-colors"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon id="menu-icon" name="ph:list" class="w-5 h-5" />
        <Icon id="close-icon" name="ph:x" class="w-5 h-5 hidden" />
      </button>
      </div>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden border-t border-line bg-paper">
    <div class="max-w-6xl mx-auto px-6 py-3 flex flex-col">
      {navLinks.map(link => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            "py-2.5 text-base transition-colors",
            isActive(link.href) ? "text-ink" : "text-muted hover:text-ink"
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</header>

<!-- Spacer for the fixed header -->
<div class="h-16"></div>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  button?.addEventListener('click', () => {
    const isExpanded = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!isExpanded));
    menu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });
</script>
