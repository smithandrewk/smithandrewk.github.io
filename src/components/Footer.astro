---
import { Icon } from 'astro-icon/components';

const currentYear = new Date().getFullYear();

const elsewhere = [
  { href: 'https://github.com/smithandrewk', label: 'GitHub', icon: 'ph:github-logo' },
  { href: 'mailto:andrewsmith@sc.edu', label: 'Email', icon: 'ph:envelope-simple' },
];
---

<footer class="mt-auto border-t border-line theme-fade">
  <div class="max-w-6xl mx-auto px-6 lg:px-8 py-10">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6">

      <div>
        <p class="font-mono text-[0.9375rem] font-medium text-ink">A. Smith</p>
        <p class="meta mt-1.5">&copy; {currentYear}</p>
      </div>

      <div class="flex items-center gap-6">
        {elsewhere.map(item => (
          <a
            href={item.href}
            target={item.href.startsWith('http') ? '_blank' : undefined}
            rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="group inline-flex items-center gap-2 text-sm text-muted hover:text-ink transition-colors"
          >
            <Icon name={item.icon} class="w-[18px] h-[18px]" />
            {item.label}
          </a>
        ))}
      </div>

    </div>
  </div>
</footer>
