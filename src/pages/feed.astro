---
/**
 * /feed — A vertical snap-scroll feed of mixed media content.
 * Photos, text cards, and before/after reveals in a TikTok-style format.
 */

const feedItems = [
  { type: "photo", src: "/images/gallery/teton_inside.jpg", caption: "Inside the Tetons", location: "Grand Teton National Park" },
  { type: "video", src: "/videos/IMG_7873_web.mp4", caption: "Playing keys", location: "True South, Greenville" },
  { type: "photo", src: "/images/timeline/europe/IMG_3509.JPG", caption: "Zermatt", location: "Switzerland" },
  { type: "video", src: "/videos/IMG_0057_web.mp4", caption: "Rain on the rooftops", location: "Chamonix, France" },
  { type: "text", headline: "Entropy", body: "On the second law of thermodynamics and its surprising applications to everyday life.", link: "/blog/entropy", label: "Read essay" },
  { type: "photo", src: "/images/gallery/museum_gig.jpg", caption: "Museum gig", location: "South Carolina" },
  { type: "video", src: "/videos/IMG_5797_web.mp4", caption: "At the range", location: "South Carolina" },
  { type: "photo", src: "/images/gallery/logging_lake.JPG", caption: "Logging Lake", location: "Montana" },
  { type: "video", src: "/videos/IMG_0254_web.mp4", caption: "Into the clouds", location: "Courmayeur, Italy" },
  { type: "before-after", before: "/images/timeline/house-renovation/1_before.jpg", after: "/images/timeline/house-renovation/1_after.JPG", caption: "House renovation" },
  { type: "photo", src: "/images/timeline/europe/DSCF0114.JPG", caption: "London", location: "England" },
  { type: "video", src: "/videos/IMG_5214_web.mp4", caption: "The Inception shot", location: "Paris" },
  { type: "photo", src: "/images/gallery/tahoe.jpeg", caption: "Lake Tahoe", location: "California" },
  { type: "photo", src: "/images/gallery/group_teton.jpg", caption: "The crew at Teton", location: "Grand Teton National Park" },
  { type: "video", src: "/videos/IMG_7052_web.mp4", caption: "Fred again.. & Lil Yachty", location: "Live" },
  { type: "text", headline: "50% ML. 20% keys. 20% coffee. 30% Robinhood.", body: "The math doesn't add up, and that's the point.", link: "/", label: "Home" },
  { type: "photo", src: "/images/gallery/teton_meadow.JPG", caption: "Teton Meadow", location: "Wyoming" },
  { type: "video", src: "/videos/IMG_2848_web.mp4", caption: "Anyma", location: "The Sphere, Las Vegas" },
  { type: "before-after", before: "/images/timeline/house-renovation/3_before.jpg", after: "/images/timeline/house-renovation/3_after.JPG", caption: "House renovation" },
  { type: "photo", src: "/images/timeline/europe/IMG_5176.jpeg", caption: "The Louvre", location: "Paris" },
  { type: "video", src: "/videos/IMG_1364_web.mp4", caption: "Zedd", location: "Dallas" },
  { type: "photo", src: "/images/gallery/zenas_mountain.JPG", caption: "Mountain view", location: "Appalachia" },
  { type: "photo", src: "/images/gallery/camp_kev.JPG", caption: "John Rock", location: "Pisgah National Forest" },
  { type: "video", src: "/videos/IMG_7122_web.mp4", caption: "Tesla test drive", location: "w/ Taylor & Drew" },
  { type: "photo", src: "/images/gallery/teton_valley.jpg", caption: "Teton Valley", location: "Wyoming" },
  { type: "before-after", before: "/images/timeline/house-renovation/5_before.jpeg", after: "/images/timeline/house-renovation/5_after.JPG", caption: "House renovation" },
  { type: "photo", src: "/images/timeline/europe/IMG_8822.JPG", caption: "Eiffel Tower", location: "Paris" },
  { type: "photo", src: "/images/gallery/group_top_teton.JPG", caption: "Top of the Grand", location: "Grand Teton National Park" },
  { type: "photo", src: "/images/gallery/john_rock.JPG", caption: "John Rock", location: "North Carolina" },
  { type: "photo", src: "/images/gallery/g_wedding_boys.jpeg", caption: "Wedding day", location: "South Carolina" },
  { type: "photo", src: "/images/timeline/europe/IMG_5186.jpeg", caption: "Europe, 2025", location: "Europe" },
  { type: "photo", src: "/images/gallery/teton_one_wheel.JPG", caption: "Onewheel in the Tetons", location: "Wyoming" },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#1A1512" />
    <style>html{background:#1A1512}</style>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Feed | Andrew Smith</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Fraunces:opsz,wght@9..144,400;9..144,600&display=swap" rel="stylesheet" />

    <style>
      :root {
        --cream: #FAF7F2;
        --linen: #F0EBE3;
        --walnut: #5C4033;
        --cognac: #C87941;
        --charcoal: #2D2D2D;
        --warm-gray: #6B6560;
        --espresso: #1A1512;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      html {
        background: var(--espresso);
        overflow: hidden;
        height: 100%;
      }

      body {
        margin: 0;
        padding: 0;
        background: var(--espresso);
        font-family: 'DM Sans', system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        height: 100%;
        overflow: hidden;
      }

      .feed {
        position: fixed;
        inset: 0;
        overflow-y: scroll;
        scroll-snap-type: y mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      }

      .feed::-webkit-scrollbar { display: none; }

      /* === Individual card === */
      .card {
        height: 100%;
        scroll-snap-align: start;
        scroll-snap-stop: always;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: flex-end;
      }

      /* === Photo card === */
      .card-photo img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      /* === Video card === */
      .card-video video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .card-video .mute-btn {
        position: absolute;
        top: calc(4.5rem + env(safe-area-inset-top, 0px));
        right: calc(1.5rem + env(safe-area-inset-right, 0px));
        z-index: 5;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: none;
        background: rgba(26, 21, 18, 0.5);
        backdrop-filter: blur(4px);
        color: rgba(250, 247, 242, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
      }

      .card-video .mute-btn svg {
        width: 18px;
        height: 18px;
      }

      .card-photo .overlay,
      .card-video .overlay,
      .card-compare .overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to top,
          rgba(26, 21, 18, 0.85) 0%,
          rgba(26, 21, 18, 0.2) 35%,
          transparent 60%
        );
        z-index: 1;
      }

      .card-info {
        position: relative;
        z-index: 2;
        padding: 2rem;
        padding-left: calc(2rem + env(safe-area-inset-left, 0px));
        padding-right: calc(2rem + env(safe-area-inset-right, 0px));
        padding-bottom: calc(2rem + env(safe-area-inset-bottom, 0px));
        width: 100%;
      }

      .card-caption {
        font-family: 'Fraunces', Georgia, serif;
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--cream);
        line-height: 1.2;
        margin-bottom: 0.375rem;
      }

      .card-location {
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(250, 247, 242, 0.5);
      }

      /* === Text card === */
      .card-text {
        background: var(--cream);
        align-items: center;
        justify-content: center;
        padding: 3rem 2rem;
      }

      .card-text .card-inner {
        max-width: 28rem;
        text-align: center;
      }

      .card-text .card-headline {
        font-family: 'Fraunces', Georgia, serif;
        font-size: 1.75rem;
        font-weight: 600;
        color: var(--walnut);
        line-height: 1.25;
        margin-bottom: 1rem;
      }

      .card-text .card-body {
        color: var(--warm-gray);
        line-height: 1.6;
        margin-bottom: 1.5rem;
      }

      .card-text .card-link {
        display: inline-block;
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--cognac);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: border-color 0.2s;
      }

      .card-text .card-link:hover {
        border-bottom-color: var(--cognac);
      }

      /* === Before/After card === */
      .card-compare {
        background: var(--espresso);
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
      }

      .card-compare img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: opacity 0.6s ease;
      }

      .card-compare .after-img {
        opacity: 0;
      }

      .card-compare.show-after .before-img {
        opacity: 0;
      }

      .card-compare.show-after .after-img {
        opacity: 1;
      }

      .card-compare .compare-badge {
        position: absolute;
        top: 1.5rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 5;
        font-size: 0.625rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: rgba(250, 247, 242, 0.8);
        padding: 0.375rem 0.75rem;
        background: rgba(26, 21, 18, 0.6);
        border-radius: 100px;
        backdrop-filter: blur(4px);
        transition: opacity 0.3s;
      }

      .card-compare .tap-hint {
        position: absolute;
        bottom: 6rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 5;
        font-size: 0.8125rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(250, 247, 242, 0.9);
        padding: 0.5rem 1.25rem;
        background: rgba(26, 21, 18, 0.6);
        border: 1px solid rgba(250, 247, 242, 0.2);
        border-radius: 100px;
        backdrop-filter: blur(4px);
        animation: fade-pulse 2s ease-in-out infinite;
        white-space: nowrap;
      }

      /* === Floating nav === */
      .feed-nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 50;
        padding: calc(1.25rem + env(safe-area-inset-top, 0px)) calc(1.5rem + env(safe-area-inset-right, 0px)) 1.25rem calc(1.5rem + env(safe-area-inset-left, 0px));
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: linear-gradient(to bottom, rgba(26,21,18,0.5), transparent);
        pointer-events: none;
      }

      .feed-nav > * {
        pointer-events: auto;
      }

      .feed-nav a, .feed-nav span {
        color: rgba(250, 247, 242, 0.8);
        text-decoration: none;
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        transition: color 0.2s;
      }

      .feed-nav a:hover {
        color: var(--cream);
      }

      .feed-nav .brand {
        font-family: 'Fraunces', Georgia, serif;
        font-size: 1rem;
        letter-spacing: 0;
        text-transform: none;
      }

      /* === Progress dots === */
      .progress {
        position: fixed;
        right: calc(0.75rem + env(safe-area-inset-right, 0px));
        top: 50%;
        transform: translateY(-50%);
        z-index: 50;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .progress-dot {
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: rgba(250, 247, 242, 0.2);
        transition: background 0.3s, transform 0.3s;
      }

      .progress-dot.active {
        background: var(--cognac);
        transform: scale(1.5);
      }

      /* === Scroll hint === */
      .scroll-hint {
        position: fixed;
        bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
        left: 50%;
        transform: translateX(-50%);
        z-index: 50;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        color: rgba(250, 247, 242, 0.4);
        font-size: 0.625rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        animation: fade-pulse 2s ease-in-out infinite;
        transition: opacity 0.5s;
      }

      .scroll-hint.hidden { opacity: 0; pointer-events: none; }

      .scroll-hint svg {
        width: 16px;
        height: 16px;
        animation: bounce-down 2s ease-in-out infinite;
      }

      @keyframes bounce-down {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(4px); }
      }

      @keyframes fade-pulse {
        0%, 100% { opacity: 0.4; }
        50% { opacity: 0.8; }
      }

      /* Card entrance animation */
      .card-info, .card-inner {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.5s ease, transform 0.5s ease;
      }

      .card.visible .card-info,
      .card.visible .card-inner {
        opacity: 1;
        transform: translateY(0);
      }

      /* Responsive */
      @media (min-width: 768px) {
        .card-caption { font-size: 2rem; }
        .card-text .card-headline { font-size: 2.25rem; }
        .card-info { padding: 3rem; }
        .progress { right: 1.25rem; }
      }
    </style>
  </head>

  <body>
    <!-- Floating top bar -->
    <nav class="feed-nav">
      <a href="/" class="brand">A. Smith</a>
      <a href="/">Back to site</a>
    </nav>

    <!-- Progress dots -->
    <div class="progress" id="progress">
      {feedItems.map((_, i) => (
        <div class="progress-dot" data-index={i} />
      ))}
    </div>

    <!-- Scroll hint (first card only) -->
    <div class="scroll-hint" id="scroll-hint">
      <span>Scroll</span>
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>

    <!-- Feed -->
    <div class="feed" id="feed">
    {feedItems.map((item, i) => {
        if (item.type === "photo") {
          return (
            <div class={`card card-photo ${i === 0 ? 'visible' : ''}`} data-index={i}>
              <img src={item.src} alt={item.caption} loading={i < 2 ? "eager" : "lazy"} />
              <div class="overlay" />
              <div class="card-info">
                <div class="card-caption">{item.caption}</div>
                {item.location && <div class="card-location">{item.location}</div>}
              </div>
            </div>
          );
        }

        if (item.type === "video") {
          return (
            <div class={`card card-video ${i === 0 ? 'visible' : ''}`} data-index={i}>
              <video
                src={item.src}
                muted
                loop
                playsinline
                preload={i < 2 ? "auto" : "none"}
              />
              <div class="overlay" />
              <button class="mute-btn" aria-label="Toggle sound">
                <svg class="icon-muted" style="display:none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707A1 1 0 0112 5v14a1 1 0 01-1.707.707L5.586 15z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
                </svg>
                <svg class="icon-unmuted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707A1 1 0 0112 5v14a1 1 0 01-1.707.707L5.586 15z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728" />
                </svg>
              </button>
              <div class="card-info">
                <div class="card-caption">{item.caption}</div>
                {item.location && <div class="card-location">{item.location}</div>}
              </div>
            </div>
          );
        }

        if (item.type === "text") {
          return (
            <div class={`card card-text ${i === 0 ? 'visible' : ''}`} data-index={i}>
              <div class="card-inner">
                <h2 class="card-headline">{item.headline}</h2>
                <p class="card-body">{item.body}</p>
                {item.link && <a href={item.link} class="card-link">{item.label} →</a>}
              </div>
            </div>
          );
        }

        if (item.type === "before-after") {
          return (
            <div class={`card card-compare ${i === 0 ? 'visible' : ''}`} data-index={i}>
              <img src={item.before} alt="Before" class="before-img" loading="lazy" />
              <img src={item.after} alt="After" class="after-img" loading="lazy" />
              <div class="overlay" />
              <span class="compare-badge">Before</span>
              <span class="tap-hint">Tap to compare</span>
              <div class="card-info">
                <div class="card-caption">{item.caption}</div>
              </div>
            </div>
          );
        }
    })}
    </div>

    <script>
      const feed = document.getElementById('feed')!;
      const dots = document.querySelectorAll('.progress-dot');
      const cards = document.querySelectorAll('.card');
      const scrollHint = document.getElementById('scroll-hint');

      // --- Intersection Observer for card visibility + video autoplay ---
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          const card = entry.target as HTMLElement;
          const index = parseInt(card.dataset.index || '0');
          const video = card.querySelector('video');

          if (entry.isIntersecting) {
            card.classList.add('visible');
            dots.forEach((dot, i) => dot.classList.toggle('active', i === index));

            // Autoplay video when visible
            if (video) {
              video.currentTime = 0;
              video.play().catch(() => {});
            }

            // Hide scroll hint after first scroll
            if (index > 0 && scrollHint) {
              scrollHint.classList.add('hidden');
            }
          } else {
            // Pause video when off-screen
            if (video) {
              video.pause();
            }
          }
        });
      }, {
        root: feed,
        threshold: 0.6
      });

      cards.forEach(card => observer.observe(card));

      // --- Preload observer: buffer videos one screen ahead ---
      const preloadObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const video = entry.target.querySelector('video') as HTMLVideoElement;
            if (video && video.preload === 'none') {
              video.preload = 'auto';
              video.load();
            }
            preloadObserver.unobserve(entry.target);
          }
        });
      }, {
        root: feed,
        rootMargin: '100% 0px',
        threshold: 0
      });

      document.querySelectorAll('.card-video').forEach(card => preloadObserver.observe(card));

      // --- Before/After tap toggle ---
      document.querySelectorAll('.card-compare').forEach(card => {
        const badge = card.querySelector('.compare-badge') as HTMLElement;
        const hint = card.querySelector('.tap-hint') as HTMLElement;

        card.addEventListener('click', () => {
          const showing = card.classList.toggle('show-after');
          badge.textContent = showing ? 'After' : 'Before';
          if (hint) hint.style.display = 'none';
        });
      });

      // --- Unmute all videos after first user interaction ---
      let hasInteracted = false;
      function unmuteAll() {
        if (hasInteracted) return;
        hasInteracted = true;
        document.querySelectorAll('.card-video').forEach(card => {
          const video = card.querySelector('video')!;
          const iconMuted = card.querySelector('.icon-muted') as HTMLElement;
          const iconUnmuted = card.querySelector('.icon-unmuted') as HTMLElement;
          video.muted = false;
          iconMuted.style.display = 'none';
          iconUnmuted.style.display = '';
        });
        document.removeEventListener('click', unmuteAll);
        document.removeEventListener('touchstart', unmuteAll);
      }
      document.addEventListener('click', unmuteAll, { once: true });
      document.addEventListener('touchstart', unmuteAll, { once: true });

      // --- Video mute/unmute toggle ---
      document.querySelectorAll('.card-video .mute-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const card = btn.closest('.card-video')!;
          const video = card.querySelector('video')!;
          const iconMuted = btn.querySelector('.icon-muted') as HTMLElement;
          const iconUnmuted = btn.querySelector('.icon-unmuted') as HTMLElement;

          video.muted = !video.muted;
          iconMuted.style.display = video.muted ? '' : 'none';
          iconUnmuted.style.display = video.muted ? 'none' : '';
        });
      });

      // --- Keyboard navigation ---
      document.addEventListener('keydown', (e) => {
        const currentCard = [...cards].findIndex(c => c.classList.contains('visible') &&
          c.getBoundingClientRect().top >= -10);
        const target = currentCard >= 0 ? currentCard : 0;

        if (e.key === 'ArrowDown' || e.key === 'j') {
          e.preventDefault();
          const next = Math.min(target + 1, cards.length - 1);
          cards[next].scrollIntoView({ behavior: 'smooth' });
        }
        if (e.key === 'ArrowUp' || e.key === 'k') {
          e.preventDefault();
          const prev = Math.max(target - 1, 0);
          cards[prev].scrollIntoView({ behavior: 'smooth' });
        }
      });
    </script>
  </body>
</html>
