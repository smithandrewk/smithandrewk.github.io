---
import Layout from '../layouts/Layout.astro';
import { AsciiEffect } from '../components/ui/ascii-effect';
---

<Layout title="Home">
  <!-- Featured Feed Card -->
  <section class="max-w-5xl mx-auto px-6 pt-8 md:pt-12">
    <a href="/feed" class="feed-card group block relative overflow-hidden rounded-warm-lg">
      <div class="feed-card-bg absolute inset-0"></div>
      <div class="relative flex items-center justify-between px-6 py-5 md:px-8 md:py-6">
        <div>
          <span class="text-xs tracking-widest uppercase text-cream/60 block mb-1">New</span>
          <span class="font-serif text-lg md:text-xl text-cream group-hover:text-white transition-colors">The Feed</span>
          <span class="text-cream/50 text-sm ml-3 hidden sm:inline">Photos, videos & moments</span>
        </div>
        <svg class="w-5 h-5 text-cream/40 group-hover:text-cream group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </a>
  </section>

  <section class="min-h-[80vh] flex items-center">
    <div class="max-w-5xl mx-auto px-6 py-20 md:py-32">
      <div class="grid md:grid-cols-[1fr,1.2fr] gap-12 md:gap-16 items-center">

        <!-- Photo -->
        <div class="order-2 md:order-1">
          <div class="aspect-[4/5] max-w-sm mx-auto md:mx-0 overflow-hidden">
            <AsciiEffect
              client:visible
              variant="flow"
              imageSrc="/media/avatar.png"
              alt="Andrew Smith, rendered live as ASCII art"
              fontSize={7}
              contrast={1.3}
              brightnessBoost={2.5}
              backgroundColor="#1A1512"
              colors={["#F0EBE3", "#C87941", "#8A5A34"]}
              fit="cover"
              scale={1.1}
              flowStrength={9}
              flowSpeed={0.2}
            />
          </div>
        </div>

        <!-- Text -->
        <div class="order-1 md:order-2">
          <p class="text-warm-gray text-sm tracking-widest uppercase mb-6">
            South Carolina
          </p>

          <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl text-walnut leading-tight mb-8">
            Andrew Smith
          </h1>

          <div class="w-12 h-px bg-cognac mb-8"></div>

          <p class="text-warm-gray leading-relaxed">
            50% chance I'm doing machine learning · 20% chance I'm playing keys · 20% chance I'm making coffee · 30% chance I'm on Robinhood · 100% chance I'm Andrew
          </p>
        </div>

      </div>
    </div>
  </section>
<style>
  .feed-card {
    box-shadow: 0 4px 24px rgba(92, 64, 51, 0.15), 0 0 0 1px rgba(200, 121, 65, 0.1);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  .feed-card:hover {
    box-shadow: 0 8px 32px rgba(92, 64, 51, 0.25), 0 0 0 1px rgba(200, 121, 65, 0.2);
    transform: translateY(-2px);
  }

  .feed-card-bg {
    background: linear-gradient(135deg, #2D2D2D 0%, #5C4033 50%, #C87941 100%);
    background-size: 200% 200%;
    animation: shimmer 6s ease-in-out infinite;
  }

  @keyframes shimmer {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
</style>
</Layout>
