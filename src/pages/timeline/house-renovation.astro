---
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';

const beforeAfterPairs = [
  { before: "/media/timeline/house-renovation/1_before.jpg", after: "/media/timeline/house-renovation/1_after.JPG" },
  { before: "/media/timeline/house-renovation/2_before.jpg", after: "/media/timeline/house-renovation/2_after.JPG" },
  { before: "/media/timeline/house-renovation/3_before.jpg", after: "/media/timeline/house-renovation/3_after.JPG" },
  { before: "/media/timeline/house-renovation/4_before.jpeg", after: "/media/timeline/house-renovation/4_after.JPG" },
  { before: "/media/timeline/house-renovation/5_before.jpeg", after: "/media/timeline/house-renovation/5_after.JPG" },
];

const generalAfter = [
  "/media/timeline/house-renovation/general_after_1.JPG",
  "/media/timeline/house-renovation/general_after_2.JPG",
  "/media/timeline/house-renovation/general_after_3.JPG",
];
---

<Layout title="House Renovation" description="August 2021 home renovation project.">
  <article class="max-w-5xl mx-auto px-6 lg:px-8 py-12 md:py-16">

    <a href="/timeline" class="inline-flex items-center gap-2 text-sm text-muted hover:text-ink transition-colors">
      <Icon name="ph:arrow-left" class="w-4 h-4" />
      Timeline
    </a>

    <header class="mt-10 mb-14 max-w-3xl">
      <p class="meta">August 2021</p>
      <h1 class="display text-4xl md:text-6xl text-ink mt-4">
        House Renovation
      </h1>
      <p class="mt-5 text-lg text-muted">
        New floors, paint, and fixtures, room by room.
      </p>
    </header>

    <div class="space-y-10 md:space-y-14">
      {beforeAfterPairs.map((pair, index) => (
        <div class="reveal grid grid-cols-2 gap-3 md:gap-5" style={`--reveal-delay:${(index % 2) * 80}ms`}>
          <figure>
            <div class="media-frame">
              <img
                src={pair.before}
                alt={`Room ${index + 1} before the renovation`}
                class="w-full"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption class="meta mt-2.5">Before</figcaption>
          </figure>
          <figure>
            <div class="media-frame">
              <img
                src={pair.after}
                alt={`Room ${index + 1} after the renovation`}
                class="w-full"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption class="meta mt-2.5 text-accent">After</figcaption>
          </figure>
        </div>
      ))}
    </div>

    <section class="mt-20 pt-12 border-t border-line">
      <h2 class="display text-2xl md:text-3xl text-ink mb-8">The finished home</h2>
      <div class="columns-1 md:columns-3 gap-4">
        {generalAfter.map((src, i) => (
          <div class="media-frame mb-4 break-inside-avoid">
            <img
              src={src}
              alt={`The finished house, view ${i + 1}`}
              class="w-full"
              loading="lazy"
              decoding="async"
            />
          </div>
        ))}
      </div>
    </section>

    <footer class="mt-16 pt-8 border-t border-line">
      <a href="/timeline" class="inline-flex items-center gap-2 text-sm text-muted hover:text-ink transition-colors">
        <Icon name="ph:arrow-left" class="w-4 h-4" />
        Back to Timeline
      </a>
    </footer>

  </article>
</Layout>
