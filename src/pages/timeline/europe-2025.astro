---
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';

const images = [
  { src: "/media/timeline/europe/IMG_3509.JPG", alt: "The Matterhorn above Zermatt" },
  { src: "/media/timeline/europe/IMG_5176.jpeg", alt: "The Louvre courtyard in Paris" },
  { src: "/media/timeline/europe/IMG_5186.jpeg", alt: "A Paris street in the afternoon" },
  { src: "/media/timeline/europe/IMG_8822.JPG", alt: "The Eiffel Tower from below" },
  { src: "/media/timeline/europe/DSCF0114.JPG", alt: "Alpine valley on the way through" },
];
---

<Layout title="Europe 2025" description="September 2025 trip through Europe.">
  <article class="max-w-5xl mx-auto px-6 lg:px-8 py-12 md:py-16">

    <a href="/timeline" class="inline-flex items-center gap-2 text-sm text-muted hover:text-ink transition-colors">
      <Icon name="ph:arrow-left" class="w-4 h-4" />
      Timeline
    </a>

    <header class="mt-10 mb-14 max-w-3xl">
      <p class="meta">September 2025</p>
      <h1 class="display text-4xl md:text-6xl text-ink mt-4">
        Europe
      </h1>
      <p class="mt-5 text-lg text-muted">
        Two weeks through Switzerland, France, and Italy.
      </p>
    </header>

    <div class="columns-1 md:columns-2 gap-4 md:gap-5">
      {images.map((image) => (
        <figure class="mb-4 md:mb-5 break-inside-avoid">
          <div class="media-frame">
            <img
              src={image.src}
              alt={image.alt}
              class="w-full"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="meta mt-2.5">{image.alt}</figcaption>
        </figure>
      ))}
    </div>

    <footer class="mt-16 pt-8 border-t border-line">
      <a href="/timeline" class="inline-flex items-center gap-2 text-sm text-muted hover:text-ink transition-colors">
        <Icon name="ph:arrow-left" class="w-4 h-4" />
        Back to Timeline
      </a>
    </footer>

  </article>
</Layout>
