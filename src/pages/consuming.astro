---
import Layout from '../layouts/Layout.astro';

const shelves = [
  {
    label: 'Books',
    items: [
      { title: "The Art of Doing Science and Engineering", by: "Richard Hamming", note: "reading now" },
      { title: "The Return of the King", by: "J.R.R. Tolkien" },
    ],
  },
  {
    label: 'Music',
    items: [
      { title: "Older and Wiser", by: "Lizzy McAlpine" },
    ],
  },
  {
    label: 'Podcasts',
    items: [
      { title: "The Diary of a CEO" },
      { title: "The All-In Podcast" },
      { title: "The Iced Coffee Hour" },
    ],
  },
];

const updated = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---

<Layout title="Consuming" description="What I'm reading, watching, and listening to.">
  <div class="max-w-5xl mx-auto px-6 lg:px-8 py-16 md:py-24">

    <header class="max-w-3xl mb-16">
      <h1 class="display text-4xl md:text-6xl text-ink">
        What I'm consuming.
      </h1>
      <p class="meta mt-6">Updated {updated}</p>
    </header>

    <!-- Three shelves, grouped. One hairline per group rather than a rule
         under every single row. -->
    <div class="space-y-14">
      {shelves.map((shelf, s) => (
        <section class="reveal grid md:grid-cols-[8rem_1fr] gap-4 md:gap-10 pt-8 border-t border-line" style={`--reveal-delay:${s * 90}ms`}>
          <h2 class="meta md:pt-1.5">{shelf.label}</h2>

          <div class="space-y-5">
            {shelf.items.map((item) => (
              <div class="flex flex-wrap items-baseline gap-x-3">
                <p class="text-lg text-ink">{item.title}</p>
                {item.note && (
                  <span class="inline-block px-2 py-0.5 rounded-[4px] font-mono text-[0.6875rem] tracking-wide bg-accent text-white">
                    {item.note}
                  </span>
                )}
                {item.by && (
                  <p class="w-full text-sm text-muted">{item.by}</p>
                )}
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

  </div>
</Layout>
