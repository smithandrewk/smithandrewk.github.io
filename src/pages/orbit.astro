</style>

<script>
  // Reveal on scroll
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } });
  }, { threshold: 0.15, rootMargin: "0px 0px -8% 0px" });
  document.querySelectorAll(".on-scroll, [data-chart]").forEach(el => io.observe(el));

  // Map: draw state outline when in view
  const mapEl = document.querySelector(".sc-map");
  if (mapEl) {
    const mio = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) mapEl.classList.add("map-drawn"); });
    }, { threshold: 0.4 });
    mio.observe(mapEl);
  }

  // Scrollytelling: activate steps, reveal arcs cumulatively
  const steps = Array.from(document.querySelectorAll<HTMLElement>(".step"));
  const arcs = new Map<string, Element>();
  document.querySelectorAll<Element>(".arc").forEach(a => arcs.set(a.getAttribute("data-city")!, a));
  const nodes = new Map<string, Element>();
  document.querySelectorAll<Element>(".node").forEach(n => nodes.set(n.getAttribute("data-city")!, n));
  const flyGroups = new Map<string, Element>();
  document.querySelectorAll<Element>(".fly-group").forEach(g => flyGroups.set(g.getAttribute("data-city")!, g));

  let activeIdx = -1;
  function setActive(idx: number) {
    if (idx === activeIdx) return;
    activeIdx = idx;
    steps.forEach((s, i) => s.classList.toggle("is-active", i === idx));
    const activeCity = steps[idx]?.getAttribute("data-city");
    // cumulative arc/node reveal up to current step
    steps.forEach((s, i) => {
      const city = s.getAttribute("data-city")!;
      const arc = arcs.get(city), node = nodes.get(city);
      const drawn = i <= idx;
      arc?.classList.toggle("drawn", drawn);
      node?.classList.toggle("shown", drawn);
      node?.classList.toggle("active", i === idx);
    });
    // only the current city's memories fly in (none on the final reveal beat)
    flyGroups.forEach((g, city) => g.classList.toggle("active", city === activeCity));
    // final beat has no city: clear photos and zoom into the full map
    const isReveal = !activeCity;
    document.querySelector(".sc-map")?.classList.toggle("map-zoom", isReveal);
  }

  const sio = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) setActive(parseInt((e.target as HTMLElement).dataset.index || "0", 10));
    });
  }, { rootMargin: "-45% 0px -45% 0px", threshold: 0 });
  steps.forEach(s => sio.observe(s));
</script>
