---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';

const events = [
  {
    slug: "europe-2025",
    year: "2025",
    title: "Europe",
    description: "Two weeks through Switzerland, France, and Italy.",
    month: "September",
    preview: ["/media/timeline/europe/IMG_3509.JPG", "/media/timeline/europe/IMG_5176.jpeg"],
    hasDetail: true,
  },
  {
    slug: "house-renovation",
    year: "2021",
    title: "House Renovation",
    description: "New floors, paint, and fixtures, room by room.",
    month: "August",
    preview: ["/media/timeline/house-renovation/1_before.jpg", "/media/timeline/house-renovation/1_after.JPG"],
    hasDetail: true,
  },
  {
    slug: "phd-begins",
    year: "2021",
    title: "PhD Journey Begins",
    description: "Started PhD research in ML and health technology at USC.",
    month: "August",
    preview: [],
    hasDetail: false,
  },
];
---

<Layout title="Timeline" description="A chronology of memories and milestones.">
  <div class="max-w-5xl mx-auto px-6 lg:px-8 py-16 md:py-24">

    <header class="max-w-3xl mb-16">
      <h1 class="display text-4xl md:text-6xl text-ink">
        A chronology of memories and milestones.
      </h1>
    </header>

    <!-- Year in the left rail, entry on the right. The rule between them is the
         spine; there is no dot-on-a-line decoration doing the same job twice. -->
    <div class="divide-y divide-line border-t border-line">
      {events.map((event, i) => {
        const Wrapper = event.hasDetail ? 'a' : 'div';
        return (
          <article class="reveal" style={`--reveal-delay:${i * 80}ms`}>
            <Wrapper
              href={event.hasDetail ? `/timeline/${event.slug}` : undefined}
              class="group grid md:grid-cols-[10rem_1fr] gap-4 md:gap-10 py-10"
            >
              <p class="meta md:pt-2">
                {event.month} {event.year}
              </p>

              <div>
                <div class="flex items-start justify-between gap-6">
                  <h2 class:list={[
                    "display text-2xl md:text-3xl text-ink",
                    event.hasDetail && "group-hover:text-accent transition-colors",
                  ]}>
                    {event.title}
                  </h2>
                  {event.hasDetail && (
                    <Icon
                      name="ph:arrow-up-right"
                      class="w-5 h-5 mt-1 shrink-0 text-faint group-hover:text-accent transition-colors"
                    />
                  )}
                </div>

                <p class="mt-3 text-lg text-muted max-w-2xl">
                  {event.description}
                </p>

                {event.preview.length > 0 && (
                  <div class="mt-6 flex gap-3">
                    {event.preview.slice(0, 2).map((src) => (
                      <div class="media-frame w-32 h-32 md:w-40 md:h-40">
                        <img
                          src={src}
                          alt=""
                          class="w-full h-full object-cover"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </Wrapper>
          </article>
        );
      })}
    </div>

    <p class="mt-14 text-muted">
      More memories to come. This timeline will grow.
    </p>

  </div>
</Layout>
